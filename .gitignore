# Environment / local secrets
.env
.env.*
!.env.example
*.log

# Udaan runtime secrets — NEVER commit
/data/*.key
/data/php-error.log
/data/maintenance.flag

# Runtime learner/session state
/data/rooms/*
!/data/rooms/.gitkeep
/data/history/*
!/data/history/.gitkeep
/data/user-cache/*
!/data/user-cache/.gitkeep
/data/sync-outbox/*
!/data/sync-outbox/.gitkeep
/data/aggregates/*
/data/insights/*
!/data/insights/.gitkeep
/data/rate-limit/*
/data/players/*
!/data/players/.gitkeep
/data/events/*
!/data/events/.gitkeep
/data/missions/*
!/data/missions/.gitkeep
/data/readiness/*
!/data/readiness/.gitkeep
/data/social/*
!/data/social/.gitkeep
/data/competition/*
!/data/competition/.gitkeep

# Runtime import state
/data/imports/pending/*
/data/content/.import.lock
/data/content/import-log.json
/data/content/runtime-cache.php

# Generated content artifacts
/data/content/manifest.json
/data/content/packs/*
/data/content/backups/*
!/data/content/backups/.gitkeep

# Python build/cache artifacts
__pycache__/
*.py[cod]

.DS_Store
Thumbs.db
.idea/
.vscode/

# Local certified release output
/dist/
